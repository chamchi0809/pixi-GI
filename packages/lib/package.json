{
  "name": "pixi-rcgi",
  "version": "0.1.0",
  "description": "Holographic Radiance Cascades global illumination for PixiJS v8. Per-object and per-pixel emissive / occlusion.",
  "keywords": [
    "pixijs",
    "pixi",
    "global-illumination",
    "radiance-cascades",
    "lighting",
    "2d",
    "webgl",
    "webgpu"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chamchi0809/pixi-GI.git",
    "directory": "packages/lib"
  },
  "homepage": "https://github.com/chamchi0809/pixi-GI#readme",
  "bugs": "https://github.com/chamchi0809/pixi-GI/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/pixi-rcgi.js",
  "module": "./dist/pixi-rcgi.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/pixi-rcgi.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "check": "node --disable-warning=ExperimentalWarning --experimental-strip-types check.ts"
  },
  "dependencies": {
    "pixi-psl": "workspace:*"
  },
  "peerDependencies": {
    "pixi.js": "^8.6.0"
  },
  "devDependencies": {
    "pixi.js": "8.19.0",
    "typescript": "6.0.3",
    "vite": "8.2.0"
  }
}
